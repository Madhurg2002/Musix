---
import Doc from '../layouts/Doc.astro';
---

<Doc title="Metronome" description="A free, web-based metronome for music theory practice.">
  <div style="max-width:760px; margin:0 auto; padding-top:12px; padding-bottom:60px;">

    <section style="text-align:center; margin-bottom:32px;">
      <h1 style="margin-top:0; font-size:2rem;">Metronome</h1>
      <p class="muted" style="margin-top:8px;">
        Set a BPM, tap the beat to start, and watch the visual ticks fire in time.
        The tone is a pure sine wave — clean and adjustable.
      </p>
    </section>

    <div style="display:flex;flex-direction:column;align-items:center;gap:20px;">
      <div style="display:flex;align-items:center;gap:20px;width:100%;max-width:640px;">
        <div style="flex:1;">
          <label style="font-size:0.85rem;color:var(--muted);font-weight:500;">Tempo (BPM)</label>
          <input
            id="bpm"
            type="number"
            min="10"
            max="280"
            value="120"
            style="width:100%;padding:12px 16px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--ink);font-size:1.2rem;text-align:center;"
          />
        </div>
        <div style="display:flex;gap:8px;flex-shrink:0;">
          <button
            id="tapBtn"
            class="btn btn-primary" style="padding:10px 18px;"
            title="Tap to set tempo"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10"/></svg>
            Tap
          </button>
          <button
            id="startBtn"
            class="btn btn-primary" style="padding:10px 18px;"
            title="Start the metronome"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Start
          </button>
          <button
            id="stopBtn"
            class="btn btn-ghost" style="padding:10px 18px;"
            title="Stop the metronome"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
            Stop
          </button>
        </div>
      </div>

      <div style="display:flex;align-items:center;gap:14px;">
        <span class="tick-mark strong" id="beatMark">♩</span>
        <span id="bpmLabel" style="color:var(--muted);font-size:0.9rem;">120 BPM</span>
        <span style="color:var(--muted);font-size:0.9rem;">·</span>
        <span id="countLabel" style="color:var(--muted);font-size:0.9rem;">♩ 1</span>
      </div>

      <div style="display:flex;gap:8px;justify-content:center;">
        <div style="display:flex;flex-direction:column;align-items:center;gap:8px;min-width:52px;">
          <div id="tick1" class="tick-mark" style="width:34px;height:34px;font-size:1rem;">1</div>
          <div id="tick2" class="tick-mark" style="width:34px;height:34px;font-size:1rem;">&amp;</div>
          <div id="tick3" class="tick-mark" style="width:34px;height:34px;font-size:1rem;">&amp;</div>
          <div id="tick4" class="tick-mark" style="width:34px;height:34px;font-size:1rem;">&amp;</div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:center;gap:8px;min-width:52px;">
          <div id="tick5" class="tick-mark" style="width:34px;height:34px;font-size:1rem;">1</div>
          <div id="tick6" class="tick-mark" style="width:34px;height:34px;font-size:1rem;">&amp;</div>
          <div id="tick7" class="tick-mark" style="width:34px;height:34px;font-size:1rem;">&amp;</div>
          <div id="tick8" class="tick-mark" style="width:34px;height:34px;font-size:1rem;">&amp;</div>
        </div>
      </div>

      <div style="text-align:center;">
        <div style="color:var(--muted);font-size:0.85rem;">
          Key: <select id="tuningSelect" style="padding:6px 10px;border-radius:6px;border:1px solid var(--line);background:var(--surface2);color:var(--ink);">
            <option value="1">1 (quarter = 120)</option>
            <option value="2">2 (half = 120)</option>
            <option value="3">3 (dotted half = 120)</option>
            <option value="4">4 (whole = 120)</option>
          </select>
        </div>
      </div>
    </div>
  </section>
</Doc>
