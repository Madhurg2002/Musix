---
import Doc from '../../layouts/Doc.astro';
import intervals from '../../../../music-theory-reference/04-data/intervals.json';
import scaleFormulas from '../../../../music-theory-reference/04-data/scale-formulas.json';
import chordFormulas from '../../../../music-theory-reference/04-data/chord-formulas.json';
---

<Doc title="Data" description="Machine-readable music theory data for use in apps, tooling, and analysis." section="Data">
  <p>
    These files are plain JSON. They're intended to be consumed directly rather than rendered
    into HTML. Each file documents its schema in the repo.
  </p>

  <h2 style="margin-top:24px;">Intervals</h2>
  <p class="muted">13 intervals: semitone count, short code, approximate just-intonation and 12-TET ratios, cents.</p>
  <pre><code>{JSON.stringify(intervals.intervals, null, 2)}</code></pre>

  <h2 style="margin-top:32px;">Scale formulas</h2>
  <p class="muted">Scales with degree formulas, semitone offset arrays, step patterns, and parent/mode relationships.</p>
  <pre><code>{JSON.stringify(scaleFormulas.scales, null, 2)}</code></pre>

  <h2 style="margin-top:32px;">Chord formulas</h2>
  <p class="muted">Chord quality, formula arrays, semitone stacks, and diatonic context.</p>
  <pre><code>{JSON.stringify(chordFormulas.chords, null, 2)}</code></pre>

  <hr />
  <p class="muted">
    For the full guitar fretboard coordinate map, see
    <a href="/data/guitar-fretboard-map.json">guitar-fretboard-map.json</a>.
    It is generated by the script in the repo and can be regenerated for alternate tunings.
  </p>
</Doc>
